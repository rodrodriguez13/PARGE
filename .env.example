# --- Obligatorias en producción ---
# Cadena de conexión de Supabase (Connect > Session pooler). Si la contraseña tiene símbolos, codifícalos (@ -> %40).
DATABASE_URL=postgresql://postgres.XXXXXXXX:TU_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Código único que se pide al entrar (el mismo para todo el equipo)
ACCESS_CODE=elige-un-codigo

# --- Opcionales ---
# Lectura de etiquetas de las cajas con IA (sin ella usa OCR local, menos preciso)
ANTHROPIC_API_KEY=
# Nombres que se sugieren al entrar
TEAM_NAMES=Héctor,César,Luis,Rubén,Otto
